pipeline {
    agent any

    tools {
        nodejs 'nodejs'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        AWS_ACCOUNT_ID = credentials('ACCOUNT_ID')
        AWS_ECR_REPO_NAME = credentials('ECR_REPO2')
        AWS_DEFAULT_REGION = 'ap-south-1'
        SONAR_TOKEN = credentials('sonar-token')
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Infra Repo') {
            steps {
                git branch: 'main',
                    credentialsId: 'GITHUB',
                    url: 'https://github.com/vighneshsikati77/infra-repo.git'
            }
        }

        stage('Install Dependencies') {   // ✅ NEW STAGE (IMPORTANT)
            steps {
                dir('backend') {
                    sh '''
                      npm install
                    '''
                }
            }
        }

        stage('Set ECR Repository URI') {
            steps {
                script {
                    env.REPOSITORY_URI =
                        "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_DEFAULT_REGION}.amazonaws.com"
                }
            }
        }

        stage('Sonarqube Analysis') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('sonar-server') {
                        sh '''
                          $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=backend \
                            -Dsonar.projectKey=backend \
                            -Dsonar.sources=. \
                            -Dsonar.login=${SONAR_TOKEN}
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                waitForQualityGate abortPipeline: false
            }
        }

        stage('OWASP Dependency Check') {
            steps {
                dir('backend') {
                    dependencyCheck additionalArguments: '--scan ./',
                                    odcInstallation: 'DP-Check'
                    dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('backend') {
                    sh '''
                      rm -rf ~/.cache/trivy
                      trivy fs --scanners vuln --no-progress . > trivyfs.txt
                    '''
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('backend') {
                    sh '''
                      docker system prune -f
                      docker build -t ${AWS_ECR_REPO_NAME}:latest .
                    '''
                }
            }
        }

        stage('Push Image to ECR') {
            steps {
                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-cred']
                ]) {
                    sh '''
                      aws sts get-caller-identity

                      aws ecr get-login-password --region ${AWS_DEFAULT_REGION} \
                        | docker login --username AWS --password-stdin ${REPOSITORY_URI}

                      docker tag ${AWS_ECR_REPO_NAME}:latest \
                        ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}

                      docker push ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                  trivy image --scanners vuln --no-progress \
                  ${REPOSITORY_URI}/${AWS_ECR_REPO_NAME}:${BUILD_NUMBER} \
                  > trivyimage.txt
                '''
            }
        }

        stage('Checkout Application Repo') {
            steps {
                git branch: 'main',
                    credentialsId: 'GITHUB-TOKEN',
                    url: 'https://github.com/vighneshsikati77/mern-app.git'
            }
        }

        stage('Update Deployment YAML') {
            environment {
                GIT_REPO_NAME = "mern-app"
                GIT_USER_NAME = "vighneshsikati77"
            }
            steps {
                dir('helm/backend') {
                    withCredentials([usernamePassword(
                        credentialsId: 'GITHUB-TOKEN',
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_PASS')]) {
                    wrap([$class: 'BuildUser']) {
                        sh '''
                          git config user.name "${BUILD_USER}"
                          git config user.email "${BUILD_USER_EMAIL}"
                          
                          sed -i "s|image: .*|image: ${REPOSITORY_URI}/backend:${BUILD_NUMBER}|" deployment.yaml

                          git add deployment.yaml
                          git commit -m "Update backend image to ${BUILD_NUMBER} by ${BUILD_USER}"
                          git push https://${GIT_USER}:${GIT_PASS}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                        '''
                    }
                }
            }
        }
    }
}
post {
        success {
            echo "Pipeline executed successfully"
        }
        failure {
            echo "Pipeline failed"
        }
    }
}

