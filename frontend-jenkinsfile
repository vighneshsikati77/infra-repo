pipeline {
    agent any

    tools {
        nodejs 'nodejs'
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('access-key')
        AWS_SECRET_ACCESS_KEY = credentials('secret-access-key')
        SCANNER_HOME          = tool('sonar-scanner')
        AWS_ACCOUNT_ID        = credentials('ACCOUNT_ID')
        AWS_ECR_REPO_NAME     = credentials('ECR_REPO1')
        AWS_DEFAULT_REGION    = 'ap-south-1'
        REPOSITORY_URI        = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com/"
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Infra Repo') {
            steps {
                git branch: 'main',
                    credentialsId: 'GITHUB',
                    url: 'https://github.com/vighneshsikati77/infra-repo.git'
            }
        }

        stage('Sonarqube Analysis') {
            steps {
                dir('frontend') {
                    withSonarQubeEnv('sonar-server') {
                        sh '''
                            $SCANNER_HOME/bin/sonar-scanner \
                            -Dsonar.projectName=frontend \
                            -Dsonar.projectKey=frontend
                        '''
                    }
                }
            }
        }

        stage('Quality Check') {
            steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }

        stage('Trivy File Scan') {
            steps {
                dir('frontend') {
                    sh 'trivy fs . > trivyfs.txt'
                }
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('frontend') {
                    sh 'docker system prune -f'
                    sh 'docker container prune -f'
                    sh 'docker build -t ${AWS_ECR_REPO_NAME} .'
                }
            }
        }

        stage('ECR Image Pushing') {
            steps {
                sh 'aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | docker login --username AWS --password-stdin ${REPOSITORY_URI}'
                sh 'docker tag ${AWS_ECR_REPO_NAME} ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}'
                sh 'docker push ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER}'
            }
        }

        stage('TRIVY Image Scan') {
            steps {
                sh 'trivy image ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}:${BUILD_NUMBER} > trivyimage.txt'
            }
        }

        stage('Checkout App Repo') {
            steps {
                git branch: 'main',
                    credentialsId: 'GITHUB',
                    url: 'https://github.com/vighneshsikati77/mern-app.git'
            }
        }

        stage('Update values.yaml & Deploy') {
            steps {
                dir('helm/frontend') {
                    withCredentials([string(credentialsId: 'GITHUB-TOKEN', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            sed -i "s|repository:.*|repository: ${REPOSITORY_URI}${AWS_ECR_REPO_NAME}|" values.yaml
                            sed -i "s|tag:.*|tag: \\"${BUILD_NUMBER}\\"|" values.yaml

                            git add values.yaml
                            git commit -m "Update image tag to ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/vighneshsikati77/infra-repo.git HEAD:main

                            helm upgrade frontend . --install
                        '''
                    }
                }
            }
        }

    }
}
